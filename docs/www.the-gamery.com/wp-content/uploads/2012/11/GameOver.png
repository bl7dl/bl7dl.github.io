jQuery(document).ready(function(){
  jQuery('.post_text_area').find('iframe[src*="youtube.com"]').first().each(function(){
    jQuery('.post > .post_thumb').children('img').remove();
    jQuery(this).prependTo('.post > .post_thumb');
  });


if(jQuery('#main_slider').length){
  jQuery('#main_slider').prependTo('#main_inner > #content');
}

// is aaron's twitch  live?
jQuery.ajax({ 
     url:'https://api.twitch.tv/kraken/streams/gameryaaron',
     dataType:'jsonp',
     success:function(channel) { 
           if(channel["stream"] != null){
                      console.log("aaron is live on twitch");
                      jQuery('#header_middle_inner').prepend('<div id="twitch-live-banner"><a href="http://www.twitch.tv/gameryaaron" target="_blank" style="display:block; width:100%; padding: 10px 0;text-align:center;color:#fff;font-weight:500;text-transform:uppercase;"><img src="http://www.the-gamery.com/wp-content/uploads/2015/12/gameryTwitchAnimated.gif" /> Aaron is Live Now on Twitch.tv!! Come say hey!  <img src="http://www.the-gamery.com/wp-content/uploads/2015/12/gameryTwitchAnimated.gif" /></a></div>');
           }else{
                      console.log("aaron is not live on twitch");
           }
      }
 });


