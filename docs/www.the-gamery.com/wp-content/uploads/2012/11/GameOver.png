.widget-number-1 .textwidget{
  text-align:center;
  margin:auto;
}

.single-post .post_thumb.image_wrapper.no_thumb img {
    max-height: 700px;
    width: auto;
}

.post_thumb {
    text-align: center;
    background: #333;
    background: url(/images/lowpoly-dark-background.png) repeat !important;
}

#content.post_single .post_author_details, .content_blog.post_single #comments .post_comments_form{
  padding: 0;
}

#content.post_single .post_author_details .post_author_info{
  padding: 20px 16px 25px;
}

.content_blog.post_single #comments .post_comments_form form#commentform{
  padding: 25px 16px;
}

#content.post_single #related_posts .post_related_title{
  margin: 0;
}

#content.post_single .post_author_details .post_author_info h5.post_author_name {
    position: relative;
    left: 70px;
}

#content.post_single .post_author_details .post_author_info .post_author_description {
    margin-top: 15px;
}

#content.post_single .post_author_details .post_author_info .post_author_avatar{
  left: 15px;
}

.puzzles_heavy .related_posts_item.post_thumb.down-3 .post_category {
    top: initial;
}

.puzzles_heavy .related_posts_item.post_thumb[class*="down"] img {
    margin-top: 0;
}

@media(max-width: 768px){
      div#header-side {
        margin-top: -10px;
        min-height: 38px;
        margin-bottom: 40px;
    }
}

@media(min-width: 768px) and (max-width: 1200px){
    div#header-side {
        margin-top: -10px;
        min-height: 38px;
        margin-bottom: 40px;
    }
}
@media(max-width: 479px) and (min-width: 0px){
    .fullwidth .right_sidebar #sidebar_main{
      width:100%;
    }

    #header_middle_inner .search_link {
        height: 30px;
        line-height: 30px;
        background: #ccc;
        padding: 0 12px;
        right: 0 !important;
    }

    #header_middle_inner .search_form .search_field {
        width: 80% !important;
    }
}
	
