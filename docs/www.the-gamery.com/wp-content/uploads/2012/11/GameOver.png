.buddypress .post_author_details, .buddypress #related_posts{
  display:none;
}

#viewmore_link {
    display: block;
    width: 90%;
    height: 54px;
    line-height: 54px;
    text-align: center;
    text-transform: uppercase;
    border: 2px solid #ccc;
    color: #ccc;
    background: transparent;
    transition: all 0.8s cubic-bezier(0, 0, 0.09, 1.1);
    margin: 5px auto;
}

#viewmore_link:hover, #viewmore_link:active{
    background: #ccc;
    color:#fff;
    font-weight: 500;
} 

