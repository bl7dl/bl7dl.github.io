           }else{
                      console.log("blake is not live on twitch");
           }
      }
 });


// Is the main channel live?
jQuery.ajax({ 
     url:'https://api.twitch.tv/kraken/streams/thegamery',
     dataType:'jsonp',
     success:function(channel) { 
           if(channel["stream"] != null){
                      console.log("The Gamery is live on twitch");
                      jQuery('#header_middle_inner').prepend('<div id="twitch-live-banner"><a href="http://www.twitch.tv/deezie123" target="_blank" style="display:block; width:100%; padding: 10px 0;text-align:center;color:#fff;font-weight:500;text-transform:uppercase;"><img src="http://www.the-gamery.com/wp-content/uploads/2015/12/gameryTwitchAnimated.gif" /> The Gamery Twitch is Live Now!! Come say hey!  <img src="http://www.the-gamery.com/wp-content/uploads/2015/12/gameryTwitchAnimated.gif" /></a></div>');
           }else{
                      console.log("The Gamery is not live on twitch");
           }
      }
 });




