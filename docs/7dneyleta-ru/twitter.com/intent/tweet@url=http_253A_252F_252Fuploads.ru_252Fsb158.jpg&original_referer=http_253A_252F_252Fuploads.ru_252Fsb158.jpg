<!DOCTYPE html>
<html lang="de" dir="ltr"
      class="">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width; initial-scale=1.0; maximum-scale=1.0;">
    <meta name="twitter:widgets:csp" content="on">
    <title>Teile einen Link auf Twitter</title>
    <link rel="stylesheet" type="text/css" media="screen" href="../../https@abs.twimg.com/a/1524078702/css/tfw/intents_rosetta.bundle.css">

    <style type="text/css">
      html { display:none; }
    </style>
    <noscript>
      <style type="text/css">
        html { display: block; }
      </style>
    </noscript>
  </head>
  
  
  <body class=" tfw de logged-out ltr nofooter  noloki">

    <div id="header" role="banner">
      <div class="bar">
        <h1 class="logo">
          <a class="alternate-context" href="../home">Twitter</a>
        </h1>

        <div id="not-logged-in">
          <a class="register alternate-context" href="../../https@twitter.com/signup@context=webintent">Registrieren</a>
        </div>
      </div>
    </div>

    <div id="bd" role="main">
      <h2 class="action-information">
      Teile einen Link mit deinen Followern
</h2>

<form
  action="https://twitter.com/intent/sessions"
  id="update-form"
  method="post">
  <div class="hd">
      <input name="original_referer" type="hidden" value="http://uploads.ru/sb158.jpg">
  <input name="url" type="hidden" value="http://uploads.ru/sb158.jpg">

      <input type="hidden" name="repost_after_login" value="/intent/tweet">
    <input type="hidden" name="authenticity_token" value="93aa95a62da5c4aa3b6620c604d5b6fbe67bf5b4">

    <label for="status" id="status-label">Text twittern</label>
  </div>


  <div class="bd ">
    <span class="field">
      <textarea id="status" name="status" required autofocus
        aria-required="true" aria-describedby="post-error char-count"
        
      > http://uploads.ru/sb158.jpg</textarea>
    </span>
  </div>

  <div class="ft">
     <fieldset class="sign-in">
  <legend>Auf Twitter anmelden</legend>
  <div class="row user ">
    <label for="username_or_email" tabindex="-1">
      Telefon, E-Mail oder Nutzername
    </label>
    <input
      type="text"
      id="username_or_email"
      name="session[username_or_email]"
      required="required"
      autocorrect="off"
      autocapitalize="off"
      aria-required="true"
      class="text"
      
      
    />
  </div>
  <div class="row password ">
    <label for="password" tabindex="-1">Passwort</label>
    <input
      type="password"
      class="password text"
      id="password"
      name="session[password]"
      required="required"
      aria-required="true"
      value
    >
  </div>
  <p>
    <input type="checkbox" name="remember_me" id="remember" value="1">
    <label for="remember">Angemeldet bleiben</label>
    &middot;
    <a
      href="../account/begin_password_reset"
      class="alternate-context"
    >Passwort vergessen?</a>
  </p>
    <input type="hidden" name="ui_metrics" autocomplete="off">
    <script src="../i/js_inst@c_name=ui_metrics" async></script>
</fieldset>

    <fieldset class="submit">
      <input
        type="submit"
        class="button selected submit"
        
        value="Anmelden und twittern">
    </fieldset>
  </div>
</form>

    </div>

        <div id="promo" >
  <div class="inner">
    <h2>
      Neu bei Twitter?
      <a class="sign-up button alternate-context" href="../../https@twitter.com/signup@context=webintent" rel="noopener">Registrieren</a>
    </h2>
    <p>
      Erhalte Updates von deinen Freunden, von Prominenten und Unternehmen, und erfahre, was es Neues in der Welt gibt.
    </p>
    <p><a href="../../support.twitter.com/groups/31-twitter-basics/topics/104-welcome-to-twitter-support/articles/215585-twitter-101-how-should-i-get-started-using-twitter" rel="noopener">Was ist Twitter? Mehr erfahren</a>.</p>
  </div>
</div>


    <script type="text/javascript" charset="utf-8" nonce="OnXQeE8GO0OiQ81xPkNMAw==">
      var twttr = twttr || {};
      twttr.form_authenticity_token = '93aa95a62da5c4aa3b6620c604d5b6fbe67bf5b4';
      if (self == top) {
        document.documentElement.style.display = 'block';
      }
    </script>

    <script src="../../https@abs.twimg.com/a/1524078702/tfw/loadrunner.js" type="text/javascript" data-path="../../https@abs.twimg.com/a/1524078702/tfw" data-main="tfw/intents/main"></script>

    <script type="text/javascript" charset="utf-8" nonce="OnXQeE8GO0OiQ81xPkNMAw==">

  var twttr = twttr || {};
  twttr.tco = {
    length: 23
  };

  using('tfw/intents/tweetbox', 'imports/jquery', function(Tweetbox, $) {
    $('#status').each(function() {
      new Tweetbox(this, 0, 0);
    });
  });

</script>

