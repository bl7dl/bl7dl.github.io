#p-cactions {
	margin: 0 0 0 260px;
	white-space: nowrap;
	width: auto;
	line-height: 1.1em;
	overflow: visible;
	background: none;
	border-collapse: collapse;
	padding-left: 1em;
	list-style: none;
	font-size: 95%;
}
#p-cactions ul {
	list-style: none;
	width: auto;
}
