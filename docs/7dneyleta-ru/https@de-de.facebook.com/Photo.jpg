brand_roles_desc":{"ADMIN":"Kann alle Aspekte des Unternehmens steuern, einschlie\u00dflich \u00c4ndern oder L\u00f6schen des Kontos sowie Hinzuf\u00fcgen oder Entfernen von Personen aus der Mitarbeiterliste.","EMPLOYEE":"Kann alle Informationen in den Unternehmenseinstellungen sehen und von den Unternehmensadministratoren Rollen zugewiesen bekommen, aber kann keine \u00c4nderungen vornehmen au\u00dfer sich selbst von einem Unternehmen zu entfernen."},"finance_roles":{"FINANCE_EDITOR":"Zahlungseditor","FINANCE_ANALYST":"Zahlungsanalyst","NONE":"Keine"},"finance_roles_desc":{"FINANCE_EDITOR":"Kann Finanzdetails deines Unternehmens sehen und bearbeiten.","FINANCE_ANALYST":"Kann Finanzdetails deines Unternehmens sehen, aber keine \u00c4nderungen vornehmen."},"ip_roles":{"ADS_RIGHTS_REVIEWER":"IP-Pr\u00fcfer","NONE":"Keine"},"ip_roles_desc":{"ADS_RIGHTS_REVIEWER":"Kann Inhalte mit m\u00f6glichem Urheberrechtsverletzungen (IP\/URV) finden, sichten und melden."},"page_roles":{"MANAGER":"Seitenadministrator","CONTENT_CREATOR":"Seitenredakteur","MODERATOR":"Seitenmoderator","ADVERTISER":"Werbetreibender einer Seite","INSIGHTS_ANALYST":"Seitenanalyst"},"page_roles_desc":{"MANAGER":"Seitenadministratoren k\u00f6nnen alle Aspekte dieser Seite verwalten. Sie k\u00f6nnen Werbeanzeigen erstellen, Insights anzeigen, Seitenrollen zuweisen, Branded Content-Einstellungen verwalten, Nachrichten als Seite senden, Beitr\u00e4ge als Seite ver\u00f6ffentlichen, Kommentare auf der Seite beantworten und l\u00f6schen, sehen, welcher Administrator einen Beitrag oder Kommentar erstellt hat, Instagram-Kommentare auf der Seite beantworten und l\u00f6schen und Instagram-Kontodetails der Seite bearbeiten.","CONTENT_CREATOR":"Seitenredakteure k\u00f6nnen: Werbeanzeigen erstellen, Insights anzeigen, Branded Content-Einstellungen verwalten, Nachrichten als Seite senden, Beitr\u00e4ge als Seite ver\u00f6ffentlichen, auf Kommentare auf der Seite antworten und diese l\u00f6schen, sehen, welcher Admin einen Beitrag oder Kommentar erstellt hat, auf Instagram-Kommentare von der Seite antworten und diese l\u00f6schen sowie Instagram-Kontodetails von der Seite bearbeiten.","MODERATOR":"Seitenmoderatoren k\u00f6nnen: Insights anzeigen, Werbeanzeigen erstellen, Branded Content-Einstellungen verwalten, Nachrichten als Seite versenden, auf Kommentare auf der Seite antworten und diese l\u00f6schen, sehen, welcher Admin einen Beitrag oder Kommentar erstellt hat sowie auf Instagram-Kommentare von der Seite antworten.","ADVERTISER":"Werbetreibende der Seite k\u00f6nnen Werbeanzeigen erstellen, Insights anzeigen, Branded Content-Einstellungen verwalten und anzeigen, welcher Admin einen Beitrag oder Kommentar erstellt hat.","INSIGHTS_ANALYST":"Seitenanalysten k\u00f6nnen Insights anzeigen, Branded Content-Einstellungen verwalten und sehen, welcher Admin einen Beitrag oder Kommentar erstellt hat."},"adaccount_roles":{"ADMIN":"Administrator des Werbekontos","GENERAL_USER":"Werbetreibender des Werbekontos","REPORTS_ONLY":"Analyst des Werbekontos"},"adaccount_roles_desc":{"ADMIN":"Kann alle Aspekte von Kampagnen verwalten, einschlie\u00dflich Erstellen von Berichten, Anzeigen und Bearbeiten von Rechnungsdetails sowie Zuweisen von Rollen f\u00fcr das Konto","GENERAL_USER":"Kann \u00fcber die deinem Konto zugeordnete Zahlungsmethode Werbeanzeigen ansehen, bearbeiten und einrichten, aber den Kontostand nicht sehen","REPORTS_ONLY":"Kann die Performance der Werbeanzeige sehen"},"app_roles":{"ADMINISTRATOR":"App-Administrator","DEVELOPER":"App-Entwickler","TESTER":"App-Tester","INSIGHTS_USER":"App-Insights-Nutzer","PARTNER_USER":"App-Partner-Nutzer"},"app_roles_desc":{"ADMINISTRATOR":"Kann Rollen verwalten, App-Einstellungen \u00e4ndern, die App testen und Insights anzeigen.","DEVELOPER":"Kann App-Einstellungen \u00e4ndern, die App testen sowie Insights anzeigen.","TESTER":"Kann die App testen.","INSIGHTS_USER":"Kann App-Insights anzeigen.","PARTNER_USER":"Diese Rolle hat keinerlei Zugrif