editor_editing_preview","ads_manager_table_loading_progress_bar","ads_pe_preloading_support_sort","ads_pe_preloading_time_fix","ads_pe_preloading_better_memoize","ads_pe_api_cache","ads_delivery_container_single_load_logging","skip_ad_redirect_get","ads_manager_api_cache_gk","facerec_friends_check_perf","face_alert_query_migration_gk","loom_config_use_v2_interp","ads_pe_faster_sync","ads_pe_navigation_no_change_on_params","ads_manager_column_order_fix","imagecore_react_functional_component","display_preloaders_asap","pac_disturbing_label_viewer_switch","ads_pe_future_date_insights_fetching","ads_manager_cache_two_min","ads_pe_preloading_filter_live","search_reduce_gql_parsing","ads_standardize_metric_tooltip","improve_date_picker_presets","ads_pe_summary_row_use_get","ax_campaign_structure_mvp","ads_manager_max_concurrent_requests"],"sv":{"SV_ADS_PERF_SCENARIO_TRACES_ACTION_BLACKLIST":{"adsInsights.table.scroll":true,"AdsQE.LOG_EXPOSURE":true,"ADS_INSIGHTS_ARTILLERY_SEGMENT_START":true,"ADS_INSIGHTS_ARTILLERY_SEGMENT_END":true,"ADS_CM_TABLE_ROW_HOVERED_OFF":true,"ADS_CM_TABLE_ROW_HOVERED_ON":true,"PERF_SCENARIO.LOG_CUSTOM_SCENARIO":true}},"userIDQEExposures":[]},1459],["CharityTaxOptions",[],{"countries":{"United States":"US","Austria":"AT","Belgium":"BE","Denmark":"DK","Finland":"FI","France":"FR","Germany":"DE","Ireland":"IE","Italy":"IT","Luxembourg":"LU","Netherlands":"NL","Norway":"NO","Poland":"PL","Portugal":"PT","Puerto Rico":"PR","Spain":"ES","Sweden":"SE","United Kingdom":"GB"},"taxOptions":{"EIN (US)":"69","VAT (EU)":"86","Other Government Issued ID":"70"}},1490],["AdsInsightsMetricDefinitionsUngated",[],{"budget":"Der Maximalbetrag, den du f\u00fcr deine Werbeanzeigen t\u00e4glich im Durchschnitt ausgeben m\u00f6chtest. Das gilt f\u00fcr die Laufzeit deiner geplanten Werbeanzeigen.","buying_type":"Die Methode, mit der du f\u00fcr Werbeanzeigen in deinen Kampagnen bezahlst und Zielgruppen f\u00fcr diese definierst: durch dynamische Auktionen, Festpreisauktionen oder Buchungsart \u201eReichweite und Frequenz\u201c.","deal_end":"Das Enddatum des Angebots, das dieser Kampagne, Anzeigengruppe oder Werbeanzeige zugeordnet ist.","deal_id":"Die ID des Angebots, das dieser Kampagne, Anzeigengruppe oder Werbeanzeige zugeordnet ist.","deal_name":"Der Name des Angebots, das dieser Kampagne, Anzeigengruppe oder Werbeanzeige zugeordnet wurde.","deal_start":"Das Startdatum des Angebots, das dieser Kampagne, Anzeigengruppe oder Werbeanzeige zugeordnet ist.","delivery":"Der aktuelle Status deiner Kampagne, Anzeigengruppe oder der Auslieferung der Werbeanzeige.","schedule":"Das Start- und das Enddatum deiner Anzeigengruppen.","start_time":"Das Datum, an dem deine Kampagne startete oder gestartet werden soll. Ein Startdatum f\u00fcr eine Kampagne basiert auf dem Zeitplan, den du in der Anzeigengruppe der Kampagne ausw\u00e4hlst.","stop_time":"Das Datum, an dem deine Kampagne endete oder beendet werden soll. Ein Enddatum f\u00fcr eine Kampagne basiert auf dem Zeitplan, den du in der Anzeigengruppe der Kampagne ausw\u00e4hlst.","canvas_avg_view_percentage_per_component":"Der durchschnittliche Aufrufanteil pro Canvas-Komponente, in \u0025","cost_per_unique_action_type":"Die Durchschnittskosten pro individueller Handlung.","action_canvas_component_id":"ID einer Komponente mit einer Canvas Ad","action_canvas_component_name":"Name einer Komponente in einer Canvas Ad","action_carousel_card_id":"Die ID der konkreten Karussell-Karte, mit der Personen interagiert haben, nachdem sie deine Werbeanzeige gesehen haben.","action_carousel_card_name":"Die konkrete Karussell-Karte, mit der Personen interagiert haben, nachdem sie deine Werbeanzeige gesehen haben. Die Karten werden mit Hilfe ihrer \u00dcberschrift identifiziert.","action_destination":"Die Zielseiten, die nach dem Besuch deiner Werbeanzeige von Personen angeklickt werden. Dies kann deine Facebook-Seite, eine externe URL f\u00fcr dein Conversion Pixel oder eine mit dem Software Development Kit (SDK) konfigurierte App sein.","action_device":"Das Ger\u00e4t, auf dem die von dir erfasste Conversion stattgefunden hat. Dies kann z. B. \u201eDesktop\u201c sein, wenn die Conversion auf einem Computer vorgenommen wurde.","action_link_click_destination":"Ziel au\u00dferhalb von Facebook, auf das Personen gelangen, wenn sie auf den Link in deiner Werbeanzeige klicken.","action_location_code":"Die in den Offline-Handlungen verwendeten Standort-Codes.","action_reaction":"Anzahl der Reaktionen auf deine Werbeanzeigen oder hervorgehobenen Beitr\u00e4ge. \u00dcber den Reaktions-Button von Werbeanzeigen k\u00f6nnen Personen unterschiedlich auf den Inhalt reagieren. Folgende Reaktionen stehen zur Auswahl: \u201eGef\u00e4llt mir\u201c, Love, Haha, Wow, Traurig oder W\u00fctend.","action_target_id":"Die ID der Zielseiten, die nach dem Besuch deiner Werbeanzeige von Personen angeklickt werden. Dies kann deine Facebook-Seite, eine externe URL f\u00fcr dein Conversion Pixel, oder eine mit dem Software Development Kit (SDK) konfigurierte App sein.","action_type":"Die Art der zu deiner Werbeanzeige, Seite, App oder Veranstaltung vorgenommenen Handlungen, nachdem jemand deine Werbeanzeige gesehen hat, selbst wenn er\/sie nicht darauf geklickt hat. Die Art der Handlungen umfassen \u201eGef\u00e4llt mir\u201c-Angaben f\u00fcr die Seite, App-Installationen, Conversions, Veranstaltungszu-\/absagen usw.","action_video_sound":"Der Tonstatus (an\/aus), wenn eine Person deine Video Ad ansieht.","action_video_type":"Aufschl\u00fcsselung der Videokennzahlen.","action_video_asset_id":"Aufschl\u00fcsselung der Kennzahlen nach Videoelement-ID","account_currency":"Die von deinem Werbekonto genutzte W\u00e4hrung.","account_id":"Die ID deines Werbekontos, die deine Werbeaktivit\u00e4ten gruppiert. Dein Werbekonto enth\u00e4lt deine Kampagnen, Werbeanzeigen und Abrechnungen.","account_name":"Der Name deines Werbekontos, unter dem deine Werbeaktivit\u00e4ten gruppiert werden. Dein Werbekonto enth\u00e4lt deine Kampagnen, Werbeanzeigen und Abrechnungen.","actions_per_impression":"Die Gesamtanzahl der Handlungen geteilt durch die Anzahl der Impressionen.","actions_results":"Die Anzahl der Handlungen infolge deiner Werbeanzeige. Die hier aufgef\u00fchrten Ergebnisse basieren auf deinem Ziel.","activity_recency":"Diese Aufschl\u00fcsselung zeigt die Ergebnisse nach den letzten Offsite-Aktivit\u00e4ten des Betrachters.","adgroup_bid_type":"Die Gebotsart deiner Werbeanzeige.","adgroup_bid_value":"Der Gebotswert deiner Werbeanzeige.","adgroup_delivery":"Hier siehst du, ob deine Werbeanzeige gerade aktiv ist.","adgroup_id":"Die eindeutige ID der Werbeanzeige, die du im Bericht siehst.","adgroup_name":"Der Name der Werbeanzeige, die du in den Berichten ansiehst.","ad_format_asset":"Die ID des Anzeigenformatelements, auf die sich die Impressionen, Klicks oder Handlungen beziehen.","age":"Das Alter der von dir erreichten Personen.","app_store_clicks":"Die Anzahl der Link-Klicks zu einem App Store in deinen Werbeanzeigen.","attention_events_per_impression":"Die Anzahl der Male, die Personen deinen Werbeanzeigen mehr Aufmerksamkeit geschenkt haben als anderen Beitr\u00e4gen und Werbeanzeigen auf Facebook oder Instagram, geteilt durch die Gesamtanzahl der Impressionen.","attention_events_unq_per_reach":"Die Anzahl der Personen, die deinen Werbeanzeigen mehr Aufmerksamkeit geschenkt haben als \u00fcblicherweise anderen Beitr\u00e4gen auf Facebook, geteilt durch die Anzahl der Personen, die du mit deinen Werbeanzeigen erreicht hast.","auction_competitiveness":"Der Auktionswettbewerb hilft dir, deine Position auf dem Markt einzusch\u00e4tzen und zu erkennen, wenn sich der Wettbewerb versch\u00e4rft. Dadurch sinken deine Chancen, die Auktion zu gewinnen.","impressions_auto_refresh":"So oft erschienen deine Werbeanzeigen auf dem Bildschirm in der rechten Spalte auf Facebook, nach einem Refresh von Facebook, aufgrund dessen eine neue Anzeige in dieser Platzierung angezeigt wurde. Impressionen durch eine automatische Refresh treten nur auf, wenn Facebook aktiv verwendet wird.","body_asset":"Die ID des Textelements, auf die sich die Impressionen, Klicks oder Handlungen beziehen.","call_to_action_asset":"Die ID des Call to Action, auf den sich die Impressionen, Klicks oder Handlungen beziehen.","call_to_action_clicks":"So oft wurde in deiner Werbeanzeige auf den Call to Action-Button geklickt.","campaign_bid_type":"Die Gebotsart deiner Anzeigengruppe.","campaign_bid_value":"Der Gebortswert deiner Anzeigengruppe.","campaign_budget_type":"Die Budgetart deiner Anzeigengruppe. Es steht Tages- oder Laufzeitbudget zur Verf\u00fcgung.","campaign_budget_value":"Der Budget-Wert deiner Anzeigengruppe.","campaign_group_budget_type":"Die Budgetart deiner Kampagne. Es steht Tages- oder Laufzeitbudget zur Verf\u00fcgung.","campaign_group_budget_value":"Der Budgetwert deiner Kampagne.","campaign_delivery":"Hier siehst du, ob deine Anzeigengruppe gerade aktiv ist.","campaign_end":"Das geplante Enddatum deiner Anzeigengruppe.","campaign_group_delivery":"So siehst du, ob deine Kampagne gerade aktiv ist.","campaign_group_end":"Das geplante Enddatum deiner Kampagne.","campaign_group_id":"Die eindeutige ID der Werbekampagne, die du im Bericht siehst. Deine Kampagne enth\u00e4lt Anzeigengruppen und Werbeanzeigen.","campaign_group_name":"Der Name der Werbekampagne, den du im Bericht siehst. Deine Kampagne enth\u00e4lt Anzeigengruppen und Werbeanzeigen.","campaign_group_start":"Das geplante Datum, an dem deine Kampagne starten soll.","campaign_id":"Die eindeutige ID der Anzeigengruppe, die du im Bericht siehst. Eine Anzeigengruppe ist eine Gruppe von Werbeanzeigen mit gemeinsamem Budget, Zeitplan und Targeting und gemeinsamer Auslieferungsoptimierung.","campaign_name":"Der Name der Anzeigengruppe, den du im Bericht siehst. Eine Anzeigengruppe ist eine Gruppe von Werbeanzeigen mit gemeinsamem Budget, Zeitplan und Targeting und gemeinsamer Auslieferungsoptimierung.","campaign_start":"Das geplante Startdatum deiner Anzeigengruppe.","canvas_avg_view_percent":"Der durchschnittliche prozentuale Canvas-Anteil, den Personen gesehen haben. Ein Canvas ist ein Vollbild, das durch einen Klick in deiner Werbeanzeige auf dem Mobilger\u00e4t ge\u00f6ffnet wird. Es kann verschiedene interaktive oder Multimedia-Elemente enthalten, z. B. Videos, Bilder oder Produktkataloge.","canvas_avg_view_time":"Die durchschnittliche Gesamtzeit in Sekunden, die Personen mit dem Ansehen eines Facebook-Canvas verbringen. Ein Canvas ist ein Vollbild, das durch einen Klick in deiner Werbeanzeige auf dem Mobilger\u00e4t ge\u00f6ffnet wird. Es kann verschiedene interaktive oder Multimedia-Elemente enthalten, z. B. Videos, Bilder oder Produktkataloge.","card_views":"So oft wurde ein Produkt aus deinem Produktkatalog in einer Werbeanzeige angesehen. Wenn du ein Karussell-Format verwendest, k\u00f6nnen Personen mehrere Produkte in einer einzigen Werbeanzeige ansehen. Die Zahlen werden t\u00e4glich aktualisiert. Aufrufe von heute sind nicht enthalten. Es handelt sich aktuell um eine Beta-Version, die nur f\u00fcr Werbeanzeigen in Verbindung mit einem Produktkatalog zur Verf\u00fcgung steht.","card_view_frequency":"So oft wurden individuelle Karussell-Karten in deinen Werbeanzeigen durchschnittlich angesehen.","card_view_ctr":"Der Prozentsatz der Personen, die deine individuellen Karussell-Karten in deinen Werbeanzeigen angesehen und einen Link-Klick ausgef\u00fchrt haben.","unique_card_view_ctr":"Der Prozentsatz der Personen, die deine individuellen Karussell-Karten in deinen Werbeanzeigen gesehen und einen Link-Klick ausgef\u00fchrt haben.","clicks":"Die Anzahl der Klicks auf deine Werbeanzeigen.","catalog_segment_value":"Der Gesamtwert aller gekauften Produkte aus deinem Katalog.","cost_per_action_result":"Der durchschnittliche Betrag, den du f\u00fcr jede deinem Ziel zugeordnete Handlung bezahlt hast.","cost_per_estimated_ad_recallers":"Die Durchschnittskosten pro gesch\u00e4tzter Steigerung der Werbeerinnerung. Dieser Wert ist nur f\u00fcr Elemente mit den Zielen \u201eMarkenbekanntheit\u201c, \u201eBeitragsinteraktionen\u201c und \u201eVideoaufrufe\u201c verf\u00fcgbar.","cost_per_inline_link_click":"Die Durchschnittskosten pro Klick auf einen Inline-Link.","cost_per_inline_post_engagement":"Die Durchschnittskosten pro Interaktion mit dem Inline-Beitrag.","cost_per_objective_result":"Durchschnittskosten pro Zielergebnis deiner Werbeanzeigen. Mit deinen Werbekampagnen versuchst du vor allem Zielergebnisse basierend auf den ausgew\u00e4hlten Zielen zu erreichen.","cost_per_optimization_result":"Die Durchschnittskosten pro Optimierungs-Event von deinen Anzeigen basierend auf deinem ausgew\u00e4hlten Conversion-Fenster.","cost_per_result":"Die Durchschnittskosten pro erzieltem Ergebnis infolge deiner Werbeanzeigen.","cost_per_store_visit":"Die Durchschnittskosten pro Besuch im Gesch\u00e4ft.","cost_per_store_visit_action:store_visit":"Die Durchschnittskosten pro Besuch im Gesch\u00e4ft.","cost_per_total_action":"Die Durchschnittskosten pro relevanter Handlung.","cost_per_unique_click":"Die Durchschnittskosten pro individuellem Klick (alle).","cost_per_unique_inline_link_click":"Die Durchschnittskosten pro individuellem Klick auf einen Inline-Link.","country":"Die L\u00e4nder, in denen die von dir erreichten Personen ans\u00e4ssig sind. Die Angaben basieren auf Informationen, wie z. B. Heimatstadt, aktueller Wohnort und geographischer Standort, von dem aus sie Facebook im Allgemeinen aufrufen.","cpc":"Die Durchschnittskosten pro Klick (alle).","cpm":"Die Durchschnittskosten pro 1.000 Impressionen.","cpp":"Die Durchschnittskosten einer Reichweite von 1.000 Personen.","ctr":"Der prozentuale Anteil der Male, die deine Werbeanzeige gesehen und ein Klick (alle) ausgef\u00fchrt wurde.","cumulative_reach":"Die Anzahl der Personen, die deine Werbeanzeigen w\u00e4hrend der Laufzeit deiner Kampagne mindestens einmal gesehen haben.","date_start":"Das Startdatum f\u00fcr deine Daten. Dieses Datum wird durch den Datumsbereich gesteuert, den du f\u00fcr deine Berichtsanzeige ausgew\u00e4hlt hast.","date_stop":"Das Enddatum f\u00fcr deine Daten. Dieses Datum wird durch den Datumsbereich gesteuert, den du f\u00fcr deine Berichtsanzeige ausgew\u00e4hlt hast.","deduping_1st_source_ad":"Das ist die Anzeigengruppe, deren Zielgruppe sich am h\u00e4ufigsten mit der Zielgruppe der ausgew\u00e4hlten Anzeigengruppe \u00fcberschneidet. Das f\u00fchrt zu einer h\u00e4ufigen Entfernung aus Auktionen.","deduping_1st_source_ratio":"Das ist die H\u00e4ufigkeit, mit der die Anzeigengruppe, deren Zielgruppe sich am h\u00e4ufigsten mit der Zielgruppe der ausgew\u00e4hlten Anzeigengruppe \u00fcberschneidet, aus Auktionen entfernt wird.","deduping_2nd_source_ad":"Das ist die Anzeigengruppe, deren Zielgruppe sich am zweith\u00e4ufigsten mit der Zielgruppe der ausgew\u00e4hlten Anzeigengruppe \u00fcberschneidet. Das f\u00fchrt zu einer h\u00e4ufigen Entfernung aus Auktionen.","deduping_2nd_source_ratio":"Das ist die H\u00e4ufigkeit, mit der diese Anzeigengruppe, deren Zielgruppe sich am zweith\u00e4ufigsten mit der Zielgruppe der ausgew\u00e4hlten Anzeigengruppe \u00fcberschneidet, aus Auktionen entfernt wird.","deduping_3rd_source_ad":"Das ist die Anzeigengruppe, deren Zielgruppe sich am dritth\u00e4ufigsten mit der Zielgruppe der ausgew\u00e4hlten Anzeigengruppe \u00fcberschneidet. Das f\u00fchrt zu einer h\u00e4ufigen Entfernung aus Auktionen.","deduping_3rd_source_ratio":"Dies ist die H\u00e4ufigkeit der Entfernung aus Auktionen f\u00fcr diese Anzeigengruppe mit der drittgr\u00f6\u00dften Anzahl von Zielgruppen\u00fcberschneidungen mit der ausgew\u00e4hlten Anzeigengruppe.","deduping_ratio":"Die H\u00e4ufigkeit, mit der Werbung insgesamt aus Auktionen entfernt wurde, entspricht dem prozentualen Anteil an Auktionen, an denen die Anzeigengruppe aufgrund sich \u00fcberschneidender Zielgruppen mit anderen Anzeigengruppen nicht teilgenommen hat.","deeplink_clicks":"Die Anzahl der Link-Klicks zu bestimmten Bereichen einer App.","description_asset":"Die ID des Beschreibungselements, auf die sich die Impressionen, Klicks oder Handlungen beziehen.","device_platform":"Die Art des Ger\u00e4ts, mobil oder Desktop, die Personen verwenden, wenn sie deine Werbeanzeige anklicken oder ansehen, so wie es im Werbeanzeigenbericht angezeigt wird.","dma":"Bei den DMA (Designated Market Area)-Regionen handelt es sich um die 210 geographischen US-amerikanischen Gebiete, in denen der lokale Fernsehkonsum durch The Nielsen Company erfasst wird.","dwell_3_sec":"H\u00e4ufigkeit, mit der deine Display Ad vollst\u00e4ndig sichtbar ist oder mindestens 50 \u0025 des Displays f\u00fcr mindestens 3 Sekunden verdeckt.","dwell_5_sec":"H\u00e4ufigkeit, mit der deine Display Ad vollst\u00e4ndig sichtbar ist oder mindestens 50 \u0025 des Displays f\u00fcr mindestens 5 Sekunden verdeckt.","dwell_7_sec":"H\u00e4ufigkeit, mit der deine Display Ad vollst\u00e4ndig sichtbar ist oder mindestens 50 \u0025 des Displays f\u00fcr mindestens 7 Sekunden verdeckt.","cost_per_dwell_3_sec":"Die Durchschnittskosten pro 1.000 3-sek\u00fcndigen Aufenthalten.","cost_per_dwell_5_sec":"Die Durchschnittskosten pro 1.000 5-sek\u00fcndigen Aufenthalten.","cost_per_dwell_7_sec":"Die Durchschnittskosten pro 1.000 7-sek\u00fcndigen Aufenthalten.","thumb_stops":"So oft wurde auf deiner Display Ad verweilt.","cost_per_dwell":"Die Durchschnittskosten pro 1.000 Aufenthalte","dwell_rate":"Wie oft jemand auf deiner Display Ad verweilt, geteilt durch die Gesamtanzahl der Impressionen","estimated_ad_recallers":"Die gesch\u00e4tzte Anzahl an zus\u00e4tzlichen Personen, die sich an deine Werbeanzeigen erinnern, wenn sie innerhalb von 2 Tagen danach gefragt werden. Dieser Wert ist nur f\u00fcr Elemente mit den Zielen \u201eMarkenbekanntheit\u201c, \u201eBeitragsinteraktionen\u201c und \u201eVideoaufrufe\u201c verf\u00fcgbar.","estimated_ad_recallers_lower_bound":"Die Untergrenze der gesch\u00e4tzten Anzahl an Personen, die sich an deine Werbeanzeige erinnern. Dieser Wert ist nur f\u00fcr Elemente mit den Zielen \u201eMarkenbekanntheit\u201c, \u201eBeitragsinteraktionen\u201c und \u201eVideoaufrufe\u201c verf\u00fcgbar.","estimated_ad_recallers_upper_bound":"Die Obergrenze der gesch\u00e4tzten Anzahl an Personen, die sich an deine Werbeanzeige erinnern. Dieser Wert ist nur f\u00fcr Elemente mit den Zielen \u201eMarkenbekanntheit\u201c, \u201eBeitragsinteraktionen\u201c und \u201eVideoaufrufe\u201c verf\u00fcgbar.","estimated_ad_recall_rate":"Die Rate, zu der sich eine gesch\u00e4tzte Anzahl an zus\u00e4tzlichen Personen an deine Werbeanzeigen erinnert, wenn sie innerhalb von 2 Tagen danach gefragt wird. Dieser Wert ist nur f\u00fcr Elemente mit den Zielen \u201eMarkenbekanntheit\u201c, \u201eBeitragsinteraktionen\u201c und \u201eVideoaufrufe\u201c verf\u00fcgbar.","estimated_ad_recall_rate_lower_bound":"Die Untergrenze der gesch\u00e4tzten Anzahl an Personen, die sich an deine Werbeanzeige erinnern, geteilt durch die Anzahl an Personen, die deine Werbeanzeige erreicht hat. Dieser Wert ist nur f\u00fcr Elemente mit den Zielen \u201eMarkenbekanntheit\u201c, \u201eBeitragsinteraktionen\u201c und \u201eVideoaufrufe\u201c verf\u00fcgbar.","estimated_ad_recall_rate_upper_bound":"Die Obergrenze der gesch\u00e4tzten Anzahl an Personen, die sich an deine Werbeanzeige erinnern, geteilt durch die Anzahl an Personen, die deine Werbeanzeige erreicht hat. Dieser Wert ist nur f\u00fcr Elemente mit den Zielen \u201eMarkenbekanntheit\u201c, \u201eBeitragsinteraktionen\u201c und \u201eVideoaufrufe\u201c verf\u00fcgbar.","household_composition":"Zusammensetzung der Haushalte, die du erreicht hast. Haushalte, deren Zusammensetzung nicht bekannt ist, werden als \u201eunbekannt\u201c angezeigt.","cost_per_household_result":"Der durchschnittliche Betrag, den du f\u00fcr jede Handlung bezahlt hast, einschlie\u00dflich Handlungen zus\u00e4tzlicher Haushaltsmitglieder. Die CPA liegen aufgrund inkrementeller HH-Conversions mit festen individuellen Impressionen niedriger als bei individuellen Nutzern.","household_frequency":"Wie h\u00e4ufig deine Werbeanzeige im Durchschnitt an Mitglieder von Haushalten ausgeliefert wurde.","household_income":"Einkommen der Haushalte, die du erreicht hast. Haushalte, die ihr Einkommen nicht angegeben haben, werden als \u201eunbekannt\u201c angezeigt.","household_reach":"Anzahl der individuellen Haushalte, an die deine Werbeanzeige ausgeliefert wurde.","household_results":"So oft haben deine Werbeanzeigen sch\u00e4tzungsweise ein Ergebnis unter Einzelpersonen und Menschen, die in ihren Haushalten leben, erzielt.","household_result_rate":"Die Anzahl der erzielten Ergebnisse einschlie\u00dflich nach Haushaltsmitgliedern geteilt durch die Anzahl der Impressionen.","frequency":"So oft wurde deine Werbeanzeige durchschnittlich gesehen.","frequency_value":"Die Anzahl der Male, die eine Werbeanzeige in deiner \u201eReichweite und Frequenz\u201c-Kampagne jeder Person angezeigt wurde.","full_view_impressions":"Die Anzahl an Vollanzeigen deiner Seitenbeitr\u00e4ge infolge deiner Werbeanzeige.","full_view_reach":"Die Anzahl der Personen, die die Beitr\u00e4ge deiner Seite infolge deiner Werbeanzeige im Vollbildmodus angesehen haben.","gender":"Das Geschlecht der von dir erreichten Personen. Personen, die ihr Geschlecht nicht angegeben haben, werden als \u201enicht angegeben\u201c aufgef\u00fchrt.","high_cpa_spend_alert":"Die Markierung gibt an, ob diese Anzeigengruppe mit einem Hinweis auf hohe CPA-Ausgaben versehen werden sollte.","impressions_gross":"So oft erschienen deine Werbeanzeigen auf dem Bildschirm. Diese Zahl wurde nicht bereinigt und enth\u00e4lt auch Impressionen von ung\u00fcltigem oder Non-Human Traffic, den Facebook herausfiltert.","hourly_stats_aggregated_by_advertiser_time_zone":"Aufschl\u00fcsselung nach Stunden, erfasst zum Auslieferungszeitpunkt der Werbeanzeigen in der Zeitzone des Werbetreibenden. Wenn deine Werbeanzeigen beispielsweise von 9:00 bis 11:00 Uhr geschaltet und dann Zielgruppen in mehreren Zeitzonen angezeigt werden, so werden diese m\u00f6glicherweise von 9:00 bis 13:00 Uhr in der Zeitzone des Werbetreibenden ausgeliefert. Die Statistiken werden in vier Gruppen von 9:00 bis 10:00 Uhr, 10:00 bis 11:00 Uhr, 11:00 bis 12:00 Uhr und 12:00 bis 13:00 Uhr erfasst.","hourly_stats_aggregated_by_audience_time_zone":"Aufschl\u00fcsselung nach Stunden, erfasst zum Auslieferungszeitpunkt der Werbeanzeigen in der Zeitzone der Zielgruppe. Wenn deine Werbeanzeigen beispielsweise von 9:00 bis 11:00 Uhr geschaltet und dann Zielgruppen in mehreren Zeitzonen angezeigt werden, so werden diese m\u00f6glicherweise von 9:00 bis 13:00 Uhr in der Zeitzone des Werbetreibenden ausgeliefert. Die Statistiken werden in zwei Gruppen von 9:00 bis 10:00 Uhr und von 10:00 bis 11:00 Uhr erfasst.","image_asset":"Die ID des Bildelements, auf die sich die Impressionen, Klicks oder Handlungen beziehen.","impressions":"So oft erschienen deine Werbeanzeigen auf dem Bildschirm.","impressions_dummy":"Dummy","impression_device":"Das Ger\u00e4t, auf dem deine letzte Werbeanzeige jemandem auf Facebook angezeigt wurde. Dies kann z. B. \u201eiPhone\u201c sein, wenn jemand deine Werbeanzeige auf einem iPhone angesehen hat.","inline_link_clicks":"Die Anzahl der Link-Klicks, die zu Zielseiten auf oder au\u00dferhalb von Facebook f\u00fchren. F\u00fcr Klicks auf Inline-Links gilt dabei ein festgelegtes Attributionsfenster von 1 Tag.","inline_link_click_ctr":"Die Zeit in Prozent, die Personen deine Werbeanzeigen gesehen haben und auf einen Inline-Link geklickt haben.","inline_post_engagement":"Die Gesamtanzahl der Handlungen, die Personen in Zusammenhang mit deinen Werbeanzeigen t\u00e4tigen. F\u00fcr Interaktionen mit einem Inline-Beitrag gilt ein festgelegtes Attributionsfenster von 1 Tag.","last_significant_edit":"Das neueste Datum einer bedeutenden \u00c4nderung an deiner Anzeigengruppe, das zum Neustart der Lernphase f\u00fchren k\u00f6nnte. Eine bedeutende \u00c4nderung ist das Anhalten deiner Anzeigengruppe oder \u00c4nderungen am Optimierungs-Event, an der Zielgruppe oder Werbeanzeige. \u00c4nderungen an der Gebotsstrategie oder am Budget sind ebenfalls bedeutend, h\u00e4ngen aber vom Ausma\u00df der \u00c4nderung ab.","kpi_results":"So oft hat deine Werbeanzeige basierend auf deinem ausgew\u00e4hlten Kampagnenziel zu einem Ergebnis gef\u00fchrt.","landing_page_view_rate":"Das Verh\u00e4ltnis zwischen Landing Page-Aufrufen und Link-Klicks.","link_url_asset":"Die ID des mit der Impression, dem Klick oder der Handlung verbundenen URL-Elements.","new_reach":"Das ist die inkrementelle Reichweite deiner Anzeigengruppe, angezeigt als prozentualer Anteil neuer Impressionen, die deine Anzeigengruppe am vergangenen Tag verzeichnet hat. Ein niedriger Prozentsatz bedeutet, dass die meisten Impressionen von Personen stammen, die deine Werbeanzeige bereits zuvor gesehen haben.","objective":"Das von dir f\u00fcr die Kampagne ausgew\u00e4hlte Ziel. Dein Ziel besagt, was du mit deiner Werbung erreichen m\u00f6chtest.","objective_results":"Die Anzahl der Zu-\/Absagen, die du basierend auf deinem ausgew\u00e4hlten Ziel mit deiner Werbekampagne erzielen wolltest. Wenn du beispielsweise das Ziel zum Hervorheben deiner Seite f\u00fcr deine Kampagne ausgew\u00e4hlt hast, dann zeigt diese Kennzahl die Anzahl der \u201eGef\u00e4llt mir\u201c-Angaben infolge deiner Werbeanzeigen an.","objective_result_rate":"Die Anzahl der erhaltenen Optimierungsergebnisse geteilt durch die Anzahl der Impressionen.","optimization_goal":"Das f\u00fcr deine Werbeanzeige oder Anzeigengruppe gew\u00e4hlte Optimierungsziel. Dein Optimierungsziel gibt an, wof\u00fcr du deine Werbeanzeigen optimieren m\u00f6chtest.","optimization_results":"So oft haben deine Werbeanzeigen basierend auf deinem ausgew\u00e4hlten Conversion-Fenster zu dem Ergebnis gef\u00fchrt, f\u00fcr das deine Anzeigengruppe derezeit optimiert wird.","percentage_audience_reached":"Der Prozentsatz deiner potenziellen Zielgruppe, den du bisher erreicht hast. Deine potenzielle Zielgruppe basiert auf den Personen, die den von dir angegebenen Zielgruppenkriterien wie Standort oder Geschlecht entsprechen.","percentage_first_time_impressions":"Der Prozentsatz deiner Tagesimpressionen von Personen, die deine Werbeanzeige zum ersten Mal sehen. Er berechnet sich als Prozentsatz der neuen Impressionen, die deine Anzeigengruppe am vergangenen Tag erzielt hat.","performance_indicator":"Das Feld wird f\u00fcr die Anzahl der Ergebnisse verwendet","placement":"Wo deine Werbeanzeige auf Facebook bereitgestellt wurde, z. B. im News Feed auf einem Mobilger\u00e4t.","place_page_id":"Die ID der Ortsseite, die an der Interaktion (Impression\/Klick) beteiligt war.","place_page_name":"Der Name der Ortsseite, die an der Interaktion (Impression\/Klick) beteiligt war. Wird zusammen mit der Aufschl\u00fcsselung der Unternehmensstandorte verwendet.","platform_position":"Wo deine Werbeanzeige innerhalb einer Plattform, beispielsweise Facebook-Desktop News Feed, mobiler Instagram-News Feed angezeigt wird.","product_id":"Die ID und der Name des Produkts, auf die sich die Impressionen, Klicks oder Handlungen beziehen.","product_item_id":"Die ID und der Name des Produkts im Zusammenhang mit dem Klick oder der Handlung.","product_set_id":"ID und Name der durch die Impression, einen Klick oder eine Handlung betroffenen Produktpalette.","publisher_platform":"Auf welcher Plattform deine Werbeanzeige angezeigt wurde, z. B. auf Facebook, Instagram, Audience Network.","reach":"Die Anzahl der Personen, die deine Werbeanzeigen mindestens einmal gesehen haben. Die Reichweite unterscheidet sich von Impressionen, denn letztere k\u00f6nnen auch mehrere Aufrufe der Werbeanzeigen durch dieselbe Person umfassen.","region":"Die Regionen, in denen die von dir erreichten Personen ans\u00e4ssig sind. Die Angaben basieren auf Informationen, wie z. B. Heimatstadt, aktueller Wohnort und geographischer Standort, von dem aus sie Facebook im Allgemeinen aufrufen.","relevance_score":"Eine Skala von 1 bis 10 zur Angabe eines Richtwerts, wie gut deine Zielgruppe auf deine Werbeanzeige reagiert. Die Bewertung wird angezeigt, wenn deine Werbeanzeige mehr als 500 Impressionen erzielt hat. Sie ist nur sichtbar, wenn Berichte zu Werbeanzeigen eingesehen werden und wird nicht f\u00fcr Anzeigengruppen und Kampagnen angezeigt.","results":"So oft hat deine Werbeanzeige basierend auf deinem ausgew\u00e4hlten Ziel und deinen Einstellungen zu einem Ergebnis gef\u00fchrt.","result_rate":"Der Anteil der Aufrufe deiner Werbeanzeigen, die zu Ergebnissen gef\u00fchrt haben.","social_clicks":"Die Anzahl der Klicks (alle) auf deine Werbeanzeige, wenn sie mit sozialen Infos angezeigt wurde \u2013 d. h. im Zusammenhang mit Freunden, die mit deiner Facebook-Seite oder Anzeige interagiert haben.","social_impressions":"So oft wurden deine Werbeanzeigen angesehen, wenn sie in Zusammenhang mit sozialen Infos angezeigt wurden \u2013 d. h. im Zusammenhang mit Freunden, die mit deiner Facebook-Seite oder Anzeige interagiert haben.","social_reach":"Die Anzahl der Personen, die deine Werbeanzeige mit sozialen Infos gesehen haben \u2013 d. h. im Zusammenhang mit Facebook-Freunden, die mit deiner Facebook-Seite oder Anzeige interagiert haben.","spend":"Der gesch\u00e4tzte Gesamtbetrag, den du f\u00fcr deine Kampagne, Anzeigengruppe oder Werbeanzeige w\u00e4hrend ihrer Laufzeit ausgegeben hast.","num_campaign_groups":"Gesamtanzahl der Kampagnen.","num_campaigns":"Die Gesamtanzahl der Anzeigengruppen.","num_active_campaign_groups":"Gesamtanzahl aller aktiven Kampagnen.","creative_ad_ids":"Die Liste der Werbeanzeigen, in denen Inhalte der Anzeige innerhalb des angegebenen Zeitraums verwendet werden.","creative_delivery_info":"Die Auslieferungsinfos einer Werbeanzeige.","creative_fingerprint_mapping_id":"Eine der Anzeigen-IDs mit dem gleichen Inhalt.","num_creative_ad_ids":"Die Gesamtanzahl der Werbeanzeigen, in denen Inhalte der Anzeige innerhalb des angegebenen Zeitraums verwendet werden.","creative_name":"Der Name des Werbeelements. Momentan wird der Name der zugeh\u00f6rigen Werbeanzeige angegeben.","store_visits":"Die gesch\u00e4tzte Anzahl der Besuche deines Gesch\u00e4ftsstandorts, die deinen Werbeanzeigen zugeordnet wurden.","store_visit_actions:store_visit":"Die gesch\u00e4tzte Anzahl der Besuche deines Gesch\u00e4ftsstandorts, die deinen Werbeanzeigen zugeordnet wurden.","title_asset":"Die ID des Titelelements, auf die sich die Impressionen, Klicks oder Handlungen beziehen.","today_spend":"Der Betrag, den du seit 0:00\u00a0Uhr des jeweiligen Tages (in der Zeitzone deines Werbekontos) f\u00fcr deine Kampagne, Anzeigengruppe oder Werbeanzeige ausgegeben hast. Wenn du ein Tagesbudget festgelegt hast, siehst du hier deinen Budgetfortschritt, sodass du wei\u00dft, wie viel du noch bis zum Ende des Tages ausgeben kannst.","total_actions":"Die Gesamtanzahl der Handlungen, die Personen vorgenommen haben und die deinen Werbeanzeigen zugeordnet werden. Hierzu geh\u00f6ren Interaktionen, Klicks und Conversions.","total_action_value":"Der Gesamtwert aller Conversions, die deinen Werbeanzeigen zugeordnet wurden.","total_unique_actions":"Die Anzahl der Personen, die eine Handlung durchgef\u00fchrt haben, die deinen Werbeanzeigen zugeordnet wurde.","unique_clicks":"Der Anzahl der Personen, die einen Klick (alle) ausgef\u00fchrt haben.","unique_ctr":"Der Prozentsatz der Personen, die deine Werbeanzeige gesehen und einen individuellen Klick (alle) ausgef\u00fchrt haben.","unique_impressions":"Die Anzahl der Personen, die deine Werbeanzeigen mindestens einmal gesehen haben.","unique_inline_link_clicks":"Die Anzahl der Personen, die auf einen Inline-Link geklickt haben.","unique_inline_link_click_ctr":"Der prozentuale Anteil der Male, die deine Werbeanzeige gesehen und auf einen Link geklickt wurde. F\u00fcr die Inline-Klickrate gilt ein festgelegtes Attributionsfenster von 1 Tag.","unique_link_clicks_ctr":"Der Prozentsatz der Personen, die deine Werbeanzeige gesehen und einen Link-Klick ausgef\u00fchrt haben.","unique_social_clicks":"Die Anzahl der Personen, die einen Klick (alle) ausgef\u00fchrt haben, wenn deine Werbeanzeige mit sozialen Infos angezeigt wurde \u2013 d. h. im Zusammenhang mit Freunden, die mit deiner Facebook-Seite oder Anzeige interagiert haben.","unique_social_impressions":"Die Anzahl der Personen, denen die Werbeanzeige mit sozialem Kontext bereitgestellt wurde.","video_asset":"Die ID des Videoelements, auf die sich die Impressionen, Klicks oder Handlungen beziehen.","website_clicks":"Die Anzahl der Link-Klicks zu deiner Webseite in deinen Werbeanzeigen.","actions:app_custom_event":"Die Anzahl der Handlungen in deiner mobilen App, die als App Events aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:app_custom_event.fb_mobile_achievement_unlocked":"Die Anzahl der Features, Level oder freigeschalteten Erfolge in deiner mobilen App, die als App Events aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:app_custom_event.fb_mobile_activate_app":"Die Anzahl neuer App-Sitzungen auf einem Mobilger\u00e4t, die als App Events aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:app_custom_event.fb_mobile_add_payment_info":"Die Anzahl der in deiner mobilen App hinzugef\u00fcgten Zahlungsinfos, die als App Events aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:app_custom_event.fb_mobile_add_to_cart":"Die Anzahl der in deiner mobilen App zum Einkaufswagen hinzugef\u00fcgten Artikel, die als App Events aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:app_custom_event.fb_mobile_add_to_wishlist":"Die Anzahl der in deiner mobilen App zur Wunschliste hinzugef\u00fcgten Artikel, die als App Events aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:app_custom_event.fb_mobile_complete_registration":"Die Anzahl der Registrierungen in deiner mobilen App, die als App Events aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:app_custom_event.fb_mobile_content_view":"Die Anzahl der Content-Aufrufe in deiner mobilen App, die als App Events aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:app_custom_event.fb_mobile_d2_retention":"Die Anzahl der zweit\u00e4gigen Kundenbindungen in deiner mobilen App, die als App Events aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:app_custom_event.fb_mobile_d7_retention":"Die Anzahl der siebent\u00e4gigen Kundenbindungen in deiner mobilen App, die als App Events aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:app_custom_event.fb_mobile_initiated_checkout":"Die Anzahl der gestarteten Kaufvorg\u00e4nge in deiner mobilen App, die als App Events aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:app_custom_event.fb_mobile_level_achieved":"Die Anzahl der abgeschlossenen Level in deiner mobilen App, die als App Events aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:app_custom_event.fb_mobile_purchase":"Die Anzahl der K\u00e4ufe in deiner mobilen App, die als App Events aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:app_custom_event.fb_mobile_rate":"Die Anzahl der eingereichten Bewertungen in deiner mobilen App, die als App Events aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:app_custom_event.fb_mobile_search":"Die Anzahl der Suchanfragen in deiner mobilen App, die als App Events aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:app_custom_event.fb_mobile_spent_credits":"Die Anzahl der Gutschriftenausgaben in deiner mobilen Spiele-App, die als App Events aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:app_custom_event.fb_mobile_tutorial_completion":"Die Anzahl der abgeschlossenen Tutorials in deiner mobilen App, die als App Events aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:app_custom_event.other":"Die Anzahl anderer Handlungen in deiner mobilen App, die als App Events aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:app_engagement":"Die Anzahl der Handlungen, einschlie\u00dflich App-Installationen, Gutschriftenausgaben und App-Nutzungen, die als App Events aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:app_install":"Die Anzahl der Installationen der Desktop-App, die als App Events aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:app_story":"Die Anzahl der Interaktionen mit Meldungen in der Desktop-App, die als App Events aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:app_use":"Die Anzahl der Nutzungen deiner Desktop-App, die als App Events aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:attention_event":"So oft wurde deinen Werbeanzeigen mehr Aufmerksamkeit geschenkt als \u00fcblicherweise anderen Beitr\u00e4gen und Werbeanzeigen auf Facebook oder Instagram.","actions:checkin":"Die Anzahl der Besuche auf deiner Facebook-Seite, die deinen Werbeanzeigen zugeordnet wurden. Wenn auf deiner Seite eine physische Adresse angegeben ist, k\u00f6nnen Personen durch ein Status-Update im News Feed oder in der Chronik posten, dass sie sich an diesem Standort befinden.","actions:commerce_event":"Die Anzahl der kommerziellen Handlungen auf Facebook infolge deiner Werbeanzeige.","actions:commerce_event.add_to_cart":"Die Anzahl der \u201eIn den Einkaufswagen\u201c-Handlungen auf Facebook infolge deiner Werbeanzeige.","actions:commerce_event.message_to_buy":"Die Anzahl der Nachrichten an Verk\u00e4ufer auf Facebook infolge deiner Werbeanzeige.","actions:commerce_event.other":"Die Anzahl anderer kommerzieller Handlungen auf Facebook infolge deiner Werbeanzeige.","actions:commerce_event.purchase":"Die Anzahl der K\u00e4ufe auf Facebook infolge deiner Werbeanzeige.","actions:commerce_event.view_content":"Die Anzahl der Produktaufrufe auf Facebook infolge deiner Werbeanzeige.","actions:receive_offer":"So oft wurde auf ein Angebot in deinen Werbeanzeigen geklickt.","actions:credit_spent":"Die Anzahl der Gutschriftenausgaben in deiner Desktop-Spiele-App, die als App Events aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:dwell":"So oft wurde auf deinen Seitenbeitr\u00e4gen infolge deiner Werbeanzeige verweilt.","actions:follow":"Die Anzahl der abonnierten Fragen infolge deiner Werbeanzeige.","actions:full_view":"So oft wurde deine Werbeanzeige ganz angesehen.","actions:games.plays":"Die Anzahl der Spiele in deiner App, das als App Events aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:gift_sale":"Die Anzahl der auf Facebook verkauften Geschenke infolge deiner Werbeanzeige.","actions:landing_page_view":"So oft hat jemand auf einen Werbeanzeigen-Link geklickt und dann erfolgreich die Ziel-Webseite geladen. Damit du Berichte zu Landing Page-Aufrufen erstellen kannst, muss das Facebook-Pixel auf deiner Webseite installiert sein.","actions:leadgen.other":"Die Anzahl der gesendeten Formularantworten aus Klicks auf Facebook-Lead Ads.","actions:like":"Die Anzahl der \u201eGef\u00e4llt mir\u201c-Angaben auf deiner Facebook-Seite, die deinen Werbeanzeigen zugeordnet wurden.","actions:link_click":"Die Anzahl der Link-Klicks in Werbeanzeigen, die zu Zielseiten auf oder au\u00dferhalb von Facebook f\u00fchren.","actions:mention":"Die Anzahl der Seitenerw\u00e4hnungen, die deinen Werbeanzeigen zugeordnet werden. Eine Erw\u00e4hnung findet statt, wenn jemand in einem Beitrag oder Kommentar auf Facebook \u201e\u0040\u201c und den Namen deiner Seite eingibt und deine Seite dann aus einer Liste ausw\u00e4hlt.","actions:messenger.block":"So oft wurden Unterhaltungen mit deinem Unternehmen aufgrund deiner Werbeanzeigen blockiert.","actions:messenger.reply":"Die Anzahl der Antworten, die an dein Unternehmen gesendet und deinen Werbeanzeigen zugeordnet wurden.","actions:mobile_app_install":"Die Anzahl der Installationen deiner mobilen App, die als App Events aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","contact_actions:contact":"Die Anzahl der Events f\u00fcr \u201eKontaktieren\u201c, die deinen Werbeanzeigen zugeordnet sind, basierend auf Conversion-Tracking-Daten aus einer oder mehreren verbundenen Datenquellen.","customize_product_actions:customize_product":"Die Anzahl der Events f\u00fcr \u201eProdukt anpassen\u201c, die deinen Werbeanzeigen zugeordnet sind, basierend auf Conversion-Tracking-Daten aus einer oder mehreren verbundenen Datenquellen.","donate_actions:donate":"Die Anzahl der Events f\u00fcr \u201eSpenden\u201c, die deinen Werbeanzeigen zugeordnet sind, basierend auf Conversion-Tracking-Daten aus einer oder mehreren verbundenen Datenquellen.","find_location_actions:find_location":"Die Anzahl der Events f\u00fcr \u201eOrt suchen\u201c, die deinen Werbeanzeigen zugeordnet sind, basierend auf Conversion-Tracking-Daten aus einer oder mehreren verbundenen Datenquellen.","schedule_actions:schedule":"Die Anzahl der Events f\u00fcr \u201eTermin vereinbaren\u201c, die deinen Werbeanzeigen zugeordnet sind, basierend auf Conversion-Tracking-Daten aus einer oder mehreren verbundenen Datenquellen.","start_trial_actions:start_trial":"Die Anzahl der Events f\u00fcr \u201eProbeabo nutzen\u201c, die deinen Werbeanzeigen zugeordnet sind, basierend auf Conversion-Tracking-Daten aus einer oder mehreren verbundenen Datenquellen.","submit_application_actions:submit_application":"Die Anzahl der Events f\u00fcr \u201eBewerbung absenden\u201c, die deinen Werbeanzeigen zugeordnet sind, basierend auf Conversion-Tracking-Daten aus einer oder mehreren verbundenen Datenquellen.","subscribe_actions:subscribe":"Die Anzahl der Events f\u00fcr \u201eAbonnieren\u201c, die deinen Werbeanzeigen zugeordnet sind, basierend auf Conversion-Tracking-Daten aus einer oder mehreren verbundenen Datenquellen.","take_survey_actions:take_survey":"Die Anzahl der Events f\u00fcr \u201eAn der Umfrage teilnehmen\u201c, die deinen Werbeanzeigen zugeordnet sind, basierend auf Conversion-Tracking-Daten aus einer oder mehreren verbundenen Datenquellen.","actions:offline_conversion.add_payment_info":"Die Anzahl der hinzugef\u00fcgten Zahlungsinfos, die durch deine Offline-Event-Daten aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:offline_conversion.add_to_cart":"Die Anzahl der \u201eIn den Einkaufswagen\u201c-Events, die durch deine Offline-Event-Daten aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:offline_conversion.add_to_wishlist":"Die Anzahl der \u201eZur Wunschliste hinzuf\u00fcgen\u201c-Events, die durch deine Offline-Event-Daten aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:offline_conversion.complete_registration":"Die Anzahl der abgeschlossenen Registrierungen, die durch deine Offline-Event-Daten aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:offline_conversion.initiate_checkout":"Die Anzahl der gestarteten Kaufvorg\u00e4nge, die durch deine Offline-Event-Daten aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:offline_conversion.lead":"Die Anzahl der Lead-Events, die durch deine Offline-Event-Daten aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:offline_conversion.other":"Die Anzahl anderer Events, die durch deine Offline-Event-Daten aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:offline_conversion.purchase":"Die Anzahl der Kauf-Events, die durch deine Offline-Event-Daten aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:offline_conversion.search":"Die Anzahl der Suchanfragen, die durch deine Offline-Event-Daten aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:offline_conversion.view_content":"Die Anzahl der Content-Aufrufe, die durch deine Offline-Event-Daten aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:offsite_conversion":"Die Anzahl der Events oder Conversions, die durch das Pixel auf deiner Webseite aufgezeichnet und deinen Werbeanzeigen zugeordnet wurden.","actions:offsite_conversion.add_to_cart":"Die Anzahl der \u201eIn den Einkaufswagen\u201c-Events, die durch das Conversion Tracking Pixel auf deiner Webseite erfasst und deinen Werbeanzeigen zugeordnet wurden.","actions:offsite_conversion.checkout":"Die Anzahl der Kaufabschl\u00fcsse, die durch das Conversion Tracking Pixel auf deiner Webseite erfasst und deinen Werbeanzeigen zugeordnet wurden.","actions:offsite_conversion.fb_pixel_add_payment_info":"Die Anzahl der hinzugef\u00fcgten Zahlungsinfos, die durch das Pixel auf deiner Webseite erfasst und deinen Werbeanzeigen zugeordnet wurden.","actions:offsite_conversion.fb_pixel_add_to_cart":"Die Anzahl der \u201eIn den Einkaufswagen\u201c-Events, die durch das Pixel auf deiner Webseite erfasst und deinen Werbeanzeigen zugeordnet wurden.","actions:offsite_conversion.fb_pixel_add_to_wishlist":"Die Anzahl der \u201eZur Wunschliste hinzuf\u00fcgen\u201c-Events, die durch das Pixel auf deiner Webseite erfasst und deinen Werbeanzeigen zugeordnet wurden.","actions:offsite_conversion.fb_pixel_complete_registration":"Die Anzahl der abgeschlossenen Registrierungen, die durch das Pixel auf deiner Webseite erfasst und deinen Werbeanzeigen zugeordnet wurden.","actions:offsite_conversion.fb_pixel_initiate_checkout":"Die Anzahl der gestarteten Kaufvorg\u00e4nge, die durch das Pixel auf deiner Webseite erfasst und deinen Werbeanzeigen zugeordnet wurden.","actions:offsite_conversion.fb_pixel_lead":"Die Anzahl der Lead-Events, die durch das Pixel auf deiner Webseite erfasst und deinen Werbeanzeigen zugeordnet wurden.","actions:offsite_conversion.fb_pixel_purchase":"Die Anzahl der Kauf-Events, die durch das Pixel auf deiner Webseite erfasst und deinen Werbeanzeigen zugeordnet wurden.","actions:offsite_conversion.fb_pixel_search":"Die Anzahl der Suchanfragen, die durch das Pixel auf deiner Webseite erfasst und deinen Werbeanzeigen zugeordnet wurden.","actions:offsite_conversion.fb_pixel_view_content":"Die Anzahl der Content-Aufrufe, die durch das Pixel auf deiner Webseite erfasst und deinen Werbeanzeigen zugeordnet wurden.","actions:offsite_conversion.key_page_view":"Die Anzahl der Schl\u00fcsselseiten-Aufrufe, die durch das Conversion Tracking Pixel auf deiner Webseite erfasst und deinen Werbeanzeigen zugeordnet wurden.","actions:offsite_conversion.lead":"Die Anzahl der Lead-Events, die durch das Conversion Tracking Pixel auf deiner Webseite erfasst und deinen Werbeanzeigen zugeordnet wurden.","actions:offsite_conversion.other":"Die Anzahl anderer Events, die durch das Conversion Tracking Pixel auf deiner Webseite erfasst und deinen Werbeanzeigen zugeordnet wurden.","actions:offsite_conversion.registration":"Die Anzahl der Registrierungen, die durch das Conversion Tracking Pixel auf deiner Webseite erfasst und deinen Werbeanzeigen zugeordnet wurden.","actions:onsite_conversion.add_to_cart":"Die Anzahl der \u201eIn den Einkaufswagen\u201c-Handlungen auf einer zu Facebook geh\u00f6renden Plattform (z. B. Seiten oder Messenger), die deinen Werbeanzeigen zugeordnet wurden.","actions:onsite_conversion.flow_complete":"So oft wurde ein Vorgang auf einer zu Facebook geh\u00f6renden Plattform (z. B. Seiten oder Messenger) abgeschlossen und deinen Werbeanzeigen zugeordnet.","actions:onsite_conversion.referral_sender_invites_sent":"Die Anzahl der Einladungen von einer Person an ihre Freunde, die deinen Werbeanzeigen zugeordnet wurden.","actions:onsite_conversion.referral_sender_message_sent":"Die Anzahl der gesendeten Referral-Einladungen, die deinen Werbeanzeigen zugeordnet wurden.","actions:onsite_conversion.messaging_block":"So oft wurden Unterhaltungen mit deinem Unternehmen im Facebook Messenger aufgrund deiner Werbeanzeigen blockiert.","actions:onsite_conversion.messaging_first_reply":"Die Anzahl der gestarteten Unterhaltungen im Facebook Messenger mit Personen, die noch nie Nachrichten mit deinem Unternehmen ausgetauscht und deinen Werbeanzeigen zugeordnet wurden.","actions:onsite_conversion.messaging_reply":"Die Anzahl der Antworten, die im Facebook Messenger an dein Unternehmen gesendet und deinen Werbeanzeigen zugeordnet wurden.","actions:onsite_conversion.messaging_conversation_started_7d":"Die Anzahl der Unterhaltungen, die deinen Werbeanzeigen zugeordnet sind und mit Personen begonnen wurden, die deinem Unternehmen entweder noch nie oder nicht innerhalb der letzten 7 Tage geschrieben haben.","actions:onsite_conversion.message_to_buy":"Die Anzahl der Nachrichten an Verk\u00e4ufer auf einer zu Facebook geh\u00f6renden Plattform (z. B. Seiten oder Messenger), die deinen Werbeanzeigen zugeordnet wurden.","actions:onsite_conversion.purchase":"Die Anzahl der K\u00e4ufe, die auf einer zu Facebook geh\u00f6renden Plattform (z. B. Seiten oder Messenger) get\u00e4tigt wurden und deinen Werbeanzeigen zugeordnet werden. Zu K\u00e4ufen auf Facebook z\u00e4hlen Conversions wie Verk\u00e4ufe von Veranstaltungstickets, Reisebuchungen oder Verk\u00e4ufe von Kinokarten, die direkt auf zu Facebook geh\u00f6renden Plattformen stattfinden.","actions:onsite_conversion.view_content":"Die Anzahl der Produktaufrufe auf einer zu Facebook geh\u00f6renden Plattform (z. B. Seiten oder Messenger), die deinen Werbeanzeigen zugeordnet wurden.","actions:page_engagement":"Die Gesamtzahl der Handlungen, die Personen auf deiner Facebook-Seite und in den Beitr\u00e4gen darauf durchf\u00fchren und die deinen Werbeanzeigen zugeordnet werden.","actions:photo_view":"Die Anzahl der Aufrufe von Fotos auf deiner Seite oder in deinen Beitr\u00e4gen, die deinen Werbeanzeigen zugeordnet wurden. Fotoaufrufe werden gez\u00e4hlt, wenn Personen auf ein Foto klicken, um es anzusehen.","actions:post":"Wie h\u00e4ufig deine Werbeanzeigen geteilt wurden. Personen k\u00f6nnen deine Werbeanzeigen oder Beitr\u00e4ge in ihrer Chronik oder der Chronik von Freunden, in Gruppen und auf ihren eigenen Seiten teilen.","actions:comment":"Die Anzahl der Kommentare auf deine Werbeanzeigen.","actions:post_engagement":"Die Gesamtanzahl der Handlungen, die Personen in Zusammenhang mit Werbeanzeigen ausf\u00fchren.","actions:post_like":"Die Anzahl an Reaktionen auf deine Werbeanzeige. \u00dcber den \u201eReaktionen\u201c-Button in einer Werbeanzeige k\u00f6nnen Personen unterschiedliche Reaktionen auf den Inhalt abgeben: \u201eGef\u00e4llt mir\u201c, Love, Haha, Wow, Traurig oder W\u00fctend.","actions:post_reaction":"Die Anzahl an Reaktionen auf deine Werbeanzeige. \u00dcber den \u201eReaktionen\u201c-Button in einer Werbeanzeige k\u00f6nnen Personen unterschiedliche Reaktionen auf den Inhalt abgeben: \u201eGef\u00e4llt mir\u201c, Love, Haha, Wow, Traurig oder W\u00fctend.","actions:rsvp":"Die Anzahl der Personen, die mit \u201eInteressiert\u201c oder \u201eZusagen\u201c auf deine Facebook-Veranstaltung reagiert haben und deinen Werbeanzeigen zugeordnet wurden.","actions:tab_view":"Die Anzahl der Seiten-Tab-Aufrufe, die deinen Werbeanzeigen zugeordnet werden. Tabs sind anpassbare Navigationselemente, die sich unterhalb des Titelbilds der Seite befinden. Die Kennzahl \u201eSeiten-Tab-Aufrufe\u201c misst, wie oft Personen auf diese Tabs geklickt haben, um zus\u00e4tzliche Inhalte und Apps auf deiner Facebook-Seite aufzurufen.","actions:video_play":"So oft wurde dein Video per Klick gestartet.","actions:video_view":"So oft wurde dein Video insgesamt mindestens 3 Sekunden oder fast ganz angesehen, je nachdem, was zuerst eingetreten ist.","actions:vote":"Die Anzahl der beantworteten Fragen infolge deiner Werbeanzeige.","unique_actions:app_custom_event.fb_mobile_achievement_unlocked":"Die Anzahl der Personen, die freigeschaltete Features in der mobilen App erzielt haben.","unique_actions:app_custom_event.fb_mobile_activate_app":"Die Anzahl der Personen, die eine mobile App gestartet haben.","unique_actions:app_custom_event.fb_mobile_add_payment_info":"Die Anzahl der Personen, die Zahlungsinfos in der mobilen App hinzugef\u00fcgt haben.","unique_actions:app_custom_event.fb_mobile_add_to_cart":"Die Anzahl der Personen, die Artikel in der mobilen App in den Einkaufswagen gelegt haben.","unique_actions:app_custom_event.fb_mobile_add_to_wishlist":"Die Anzahl der Personen, die auf \u201eZur Wunschliste hinzuf\u00fcgen\u201c geklickt haben.","unique_actions:app_custom_event.fb_mobile_complete_registration":"Die Anzahl der Personen, die Registrierungen in der mobilen App vorgenommen haben.","unique_actions:app_custom_event.fb_mobile_content_view":"Die Anzahl der Personen, die Content in der mobilen App aufgerufen haben.","unique_actions:app_custom_event.fb_mobile_d2_retention":"Die Anzahl der Personen mit einer zweit\u00e4gigen Kundenbindung in mobiler App.","unique_actions:app_custom_event.fb_mobile_d7_retention":"Die Anzahl der Personen mit einer siebent\u00e4gigen Kundenbindung in mobiler App.","unique_actions:app_custom_event.fb_mobile_initiated_checkout":"Die Anzahl der Personen, die K\u00e4ufe in der mobilen App abgeschlossen haben.","unique_actions:app_custom_event.fb_mobile_level_achieved":"Die Anzahl der Personen, die Level in der mobilen App abgeschlossen haben.","unique_actions:app_custom_event.fb_mobile_purchase":"Die Anzahl der Personen, die K\u00e4ufe in der mobilen App vorgenommen haben.","unique_actions:app_custom_event.fb_mobile_rate":"Die Anzahl der Personen, die Bewertungen in der mobilen App eingereicht haben.","unique_actions:app_custom_event.fb_mobile_search":"Die Anzahl der Personen, die Suchanfragen in der mobilen App vorgenommen haben.","unique_actions:app_custom_event.fb_mobile_spent_credits":"Die Anzahl der Personen, die Gutschriftenausgaben in der mobilen App vorgenommen haben.","unique_actions:app_custom_event.fb_mobile_tutorial_completion":"Die Anzahl der Personen, die Tutorials in der mobilen App abgeschlossen haben.","unique_actions:attention_event":"Die Anzahl der Personen, die deinen Werbeanzeigen mehr Aufmerksamkeit geschenkt haben als \u00fcblicherweise anderen Beitr\u00e4gen auf Facebook.","unique_actions:dwell":"Die Anzahl der Personen, die infolge deiner Werbeanzeige auf deinen Seitenbeitr\u00e4gen verweilt haben.","unique_actions:full_view":"Die Anzahl der Personen, die deine Werbeanzeige mindestens einmal ganz gesehen haben.","unique_actions:landing_page_view":"Die Anzahl der Personen, die eine Landing Page aufgerufen haben.","unique_actions:link_click":"Die Anzahl der Personen, die einen Link-Klick vorgenommen haben.","action_values:app_custom_event":"Der Gesamtertrag aus Handlungen in mobiler App. Dieser Betrag basiert auf dem Wert, den du deinem App Event bei der Einrichtung zugewiesen hast.","action_values:app_custom_event.fb_mobile_add_to_cart":"Der Gesamtertrag aus \u201eIn den Einkaufwagen\u201c in mobiler App. Dieser Betrag basiert auf dem Wert, den du deinem App Event bei der Einrichtung zugewiesen hast.","action_values:app_custom_event.fb_mobile_add_to_wishlist":"Der Gesamtertrag aus \u201eZur Wunschliste hinzuf\u00fcgen\u201c in mobiler App. Dieser Betrag basiert auf dem Wert, den du deinem App Event bei der Einrichtung zugewiesen hast.","action_values:app_custom_event.fb_mobile_content_view":"Der Gesamtertrag aus Content-Aufrufen in mobiler App. Dieser Betrag basiert auf dem Wert, den du deinem App Event bei der Einrichtung zugewiesen hast.","action_values:app_custom_event.fb_mobile_initiated_checkout":"Der Gesamtertrag aus Kaufabschl\u00fcssen in mobiler App. Dieser Betrag basiert auf dem Wert, den du deinem App Event bei der Einrichtung zugewiesen hast.","action_values:app_custom_event.fb_mobile_purchase":"Der Gesamtertrag aus K\u00e4ufen in mobiler App. Dieser Betrag basiert auf dem Wert, den du deinem App Event bei der Einrichtung zugewiesen hast.","action_values:app_custom_event.fb_mobile_rate":"Der Gesamtertrag aus Bewertungen in deiner mobilen App. Dieser Betrag basiert auf dem Wert, den du deinem App Event bei der Einrichtung zugewiesen hast.","action_values:app_custom_event.fb_mobile_spent_credits":"Der Gesamtertrag aus Gutschriftenausgaben in mobiler App. Dieser Betrag basiert auf dem Wert, den du deinem App Event bei der Einrichtung zugewiesen hast.","action_values:commerce_event.purchase":"Der Gesamtertrag aus kommerziellen K\u00e4ufe auf Facebook infolge deiner Werbeanzeige.","action_values:credit_spent":"Der Gesamtertrag aus Gutschriftenausgaben, die deinen Werbeanzeigen zugeordnet wurden. Dieser Betrag basiert auf dem Wert, den du deinem App Event bei der Einrichtung zugewiesen hast.","action_values:gift_sale":"Der Gesamtertrag aus Conversions durch Geschenkverk\u00e4ufe infolge deiner Werbeanzeige.","contact_value:contact":"Der Gesamtwert aller Conversions durch \u201eKontaktieren\u201c.","customize_product_value:customize_product":"Der Gesamtwert aller Conversions durch \u201eProdukt anpassen\u201c.","donate_value:donate":"Der Gesamtwert aller Conversions durch \u201eSpenden\u201c.","find_location_value:find_location":"Der Gesamtwert aller Conversions durch \u201eOrt suchen\u201c.","schedule_value:schedule":"Der Gesamtwert aller Conversions durch \u201eTermin vereinbaren\u201c.","start_trial_value:start_trial":"Der Gesamtwert aller Conversions durch \u201eProbeabo nutzen\u201c.","submit_application_value:submit_application":"Der Gesamtwert aller Conversions durch \u201eBewerbung absenden\u201c.","subscribe_value:subscribe":"Der Gesamtwert aller Conversions durch \u201eAbonnieren\u201c.","take_survey_value:take_survey":"Der Gesamtwert aller Conversions durch \u201eAn der Umfrage teilnehmen\u201c.","action_values:offline_conversion.add_payment_info":"Der Gesamtertrag aus Conversions durch hinzugef\u00fcgte Zahlungsinfos (Offline-Conversion). Dieser Betrag basiert auf dem Wert, den du deinem Offline-Event bei der Einrichtung zugewiesen hast.","action_values:offline_conversion.add_to_cart":"