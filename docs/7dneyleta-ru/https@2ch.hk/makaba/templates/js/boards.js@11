var cloudBoard = {
	bdata: [],
	bfound: [],
	ndata: [],
	pixels:{min:16,max:60},
	order:'speed',
	displaytype:'list',
	newspage: 0,
	sortby : function(field, reverse, primer) {
	   var key = function (x) {return primer ? primer(x[field]) : x[field]};
	   return function (a,b) {
		  var A = key(a), B = key(b);
		  return ( (A < B) ? -1 : ((A > B) ? 1 : 0) ) * [-1,1][+!!reverse];                  
	   }
	},
	findb  : function(query) {
		if(query=='') { 
			this.display(this.displaytype,this.order);
		} else {
			this.bfound = [];
			$.each(this.bdata, function(index, board) {
				if(board.id.toLowerCase().search(query)!==-1||board.name.toLowerCase().search(query)!==-1) {
					cloudBoard.bfound.push(board);
				}
			});
			this.display(this.displaytype,this.order,this.bfound);
		}
	},
	getdata: function(){
		var url = 'userboards.json';
		if(window.location.pathname === '/') {
			url = 'boards.json';
		}

		$.getJSON(
			url,
			function(data){
				$.each(data.boards, function(index, board) { //полученный json перебираем заново, чтобы дополнить ключем size (размер шрифта исходя из скорости постинга)
					cloudBoard.bdata.push({id:board.id,name:board.name,speed:board.speed,threads:board.threads,unique_posters:board.unique_posters,last_num:board.last_num,info:board.info,size:Math.round(cloudBoard.pixels.min + (board.unique_posters*2/cloudBoard.pixels.max))});
				});	
			})
			.then(function() {cloudBoard.display('list',this.order);});
		
	},
	getnews: function(d){
		direction = $(d).data('page') || 0;
		var page;
		if(direction == 'up') {
			this.newspage += 1;
			page = this.newspage;
			if(this.newspage > 10) {this.newspage = 10}
			$('#cur_page').html(this.newspage);
		} else if (direction == 'down') {
			this.newspage -= 1;
			page = this.newspage;
			if(this.newspage < 0) {this.newspage = 0}
			$('#cur_page').html(this.newspage);
		}
		if(this.newspage == 0) {page = 'index'}
		var url = 'news/' + page + '.json';
		cloudBoard.ndata = [];
		$.getJSON(
			url,
			function(data){
				$.each(data.threads, function(index, thread) { 
					cloudBoard.ndata.push({num:thread.posts['0'].num,subject:thread.posts['0'].subject,timestamp:thread.posts['0'].timestamp,posts_count:thread.posts_count});
				});	
			})
			.then(function() {cloudBoard.displaynews();});
	},
	displaynews: function(data){
		data = data || this.ndata;
		var htmlcode = '';
		var counter  = 0;
		var max      = 30;
		data.sort(this.sortby('timestamp', false, parseInt));
		data = data.slice(0,max);
		htmlcode += '';
		$.each(data, function(index, thread) {
			if(counter==0){htmlcode += '<div class="column50"><ul>'}
			htmlcode += '<li>';
			htmlcode += '<i class="fa fa-newspaper-o"></i><a href="news/res/' + thread.num + '.html" title="' + thread.subject + '">' + thread.subject + '</a>' + ' <span title="Комментарии" class="news-posts-count">(' + thread.posts_count + ')</span>';
			htmlcode += '</li>';
			if(counter==parseInt(max/2)-1){htmlcode += '</ul></div><div class="column50"><ul>'}
			if(counter==max-1){htmlcode += '</div>';}
			
			//htmlcode += '<div class="tr board madape">';
			//htmlcode += '<div class="td board-title">' +  '<i class="fa fa-newspaper-o"></i><a href="news/res/' + thread.num + '.html" title="' + thread.subject + '">' + thread.subject + '</a>' + '</div>';
			//htmlcode += '<div class="td board-posts">' +  thread.views + '</div>';
			//htmlcode += '</div>';
			counter  += 1; 
		});
		
		$('#news').html(htmlcode);
	},
	display: function(type,order,data){
		data = data || this.bdata;
		var htmlcode = '';
		if (order=='az') { //сортируем список до вывода. 2 вида сортировки - по алфавиту и по скорости. 
			this.order = 'az';
			data.sort(this.sortby('id', true, function(a){return a.toUpperCase()}));	
		} else {
			this.order = 'unique_posters';
			data.sort(this.sortby('unique_posters', false, parseInt));
		}
		
		if(type=='list') {
			this.displaytype = 'list';
			
			$.each(data, function(index, board) {
				htmlcode += '<div class="tr board madape" data-board="' + board.id + '">';
				htmlcode += '<div class="td board-title"><p class="board-cell"><a href="./' + board.id + 'default.htm">/' + board.id + '/</a></p></div><div class="td board-name"> <p class="board-cell">' + board.name + '</p></div>';
				
				htmlcode += '<div class="td board-speed"><p class="board-cell">' + board.speed + '</p></div> <div class="td board-ip"><p class="board-cell">' + board.unique_posters + '</p></div><div class="td board-desc"><p class="board-cell">' + board.info + '</p></div><div class="td board-posts"><p class="board-cell">' + board.last_num + '</p></div>';
				
				htmlcode += '</div>';
			});
			
			$('.cloudboard').html(htmlcode);
		} else if (type=='cloud') {
			this.displaytype = 'cloud';	
		
			
			htmlcode += '<div style="text-align:center; width:550px;">';
			$.each(data, function(index, board) {
				htmlcode += '<a class="cloudlink madape" data-board="' + board.id + '" style="font-size:' + board.size + 'px; padding_3A 0 0.4em0 0.4em;" href="./' + board.id + 'default.htm">' + board.id + '</a> ';
			});	
			htmlcode += '</div>';
			$('.cloudboard').html(htmlcode);
		}
	}
};